{
  "mcpServers": {
    "browserless": {
      "type": "http",
      "url": "https://mcp.browserless.io/mcp",
      "headers": {
        "Authorization": "Bearer ${user_config.browserless_token}",
        "x-browserless-api-url": "${user_config.api_url}",
        "x-browserless-artifact-delivery": "mcp-resource"
      }
    }
  }
}
